# ==============================================================================
# DSA TRACKER BACKEND CONFIGURATION
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="DSA Tracker API"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Supabase Configuration
# Required: The base URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# Required: Supabase Anonymous public key (for public client verification)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required: Supabase Service Role Key (NEVER expose to frontend, used for admin tasks/migrations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: Supabase JWT Secret (found in Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Judge0 Execution Service Configuration
# Endpoint for Judge0 submission (e.g. RapidAPI or CE instance)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# RapidAPI key or Judge0 auth token
JUDGE0_API_KEY=your-judge0-api-key
JUDGE0_HOST=judge0-ce.p.rapidapi.com
# Execution timeout in seconds per test case
JUDGE0_TIMEOUT_SECONDS=5.0
# When true, fallback to safe localized execution runner if Judge0 is unreachable/offline
ALLOW_SANDBOX_FALLBACK=true

# AI Assistant (optional; deterministic fallback works without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
